{
  "name": "repasses",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fechamento de consignação no navegador, sem enviar dados para servidor.",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check && tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.15.30",
    "@types/papaparse": "^5.3.16",
    "typescript": "^6.0.3"
  }
}
