---
import Base from "../../layouts/Base.astro";
import ToolCopy from "../../components/ToolCopy.astro";
import PdfSuite from "../../components/PdfSuite.astro";
import { TOOL_LANDINGS, toolLandingJsonLd } from "../../data/toolLandings";
import type { ToolLandingEntry } from "../../data/toolLandings";

interface Props {
  entry: ToolLandingEntry;
}

export function getStaticPaths() {
  return TOOL_LANDINGS.filter((entry) => entry.parentPath === "/pdf/")
    .map((entry) => ({ params: { tool: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
---

<Base
  title={entry.title}
  description={entry.description}
  jsonLd={toolLandingJsonLd(entry)}
  styles={["/pdf/pdf.css"]}
  scripts={["/pdf/pdf.js"]}
>
  <ToolCopy entry={entry}>
    <PdfSuite slug={entry.slug} />
  </ToolCopy>
</Base>
