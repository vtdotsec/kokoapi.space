---
import Base from "../../layouts/Base.astro";
import { TOOL_LANDINGS } from "../../data/toolLandings";

const tools = TOOL_LANDINGS.filter((e) => e.parentPath === "/pdf/");
---

<Base
  title="PDF tools — merge, split, compress and edit PDFs free"
  description="Every PDF task on its own page: merge, split, compress, reorder, rotate, watermark, unlock, extract text and more — all running locally in your browser."
>
  <section class="container home-intro">
    <h1>PDF tools</h1>
    <p class="lead">
      A dedicated page for every PDF task: merge, compress, split, reorder, rotate,
      page numbers, watermark, unlock, text extraction and image conversion. Each tool
      runs locally in your browser — nothing is ever uploaded.
    </p>
  </section>

  <section class="container home-block" aria-labelledby="pdf-tools-heading">
    <div class="section-title">
      <h2 id="pdf-tools-heading">Tools</h2>
    </div>
    <div class="app-index">
      {tools.map((t) => (
        <a class="app-row" href={`${t.parentPath}${t.slug}/`}>
          <span class="app-row-top">
            <span class="app-row-name">{t.crumb}</span>
            <span class="app-row-path">{`${t.parentPath}${t.slug}/`}</span>
          </span>
          <span class="app-row-desc">{t.description}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
