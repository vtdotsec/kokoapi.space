---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import {
  getProducts,
  getCategories,
  archLabel,
  cpuLabel,
} from "../../lib/catalog";

const [products, categories] = await Promise.all([getProducts(), getCategories()]);
const categoryTitle = new Map(categories.map((c) => [c.id, c.data.title]));
const categoryCount = new Map<string, number>();

/* ------- Facet computation (server side, for deterministic output) ---- */
function tally(values: string[]): Map<string, number> {
  const m = new Map<string, number>();
  for (const v of values) m.set(v, (m.get(v) ?? 0) + 1);
  return m;
}

const licenseFacets = [...tally(products.map((p) => p.data.license))];
licenseFacets.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const dbFacets = [...tally(products.flatMap((p) => p.data.databases))].filter(
  ([, n]) => n > 0,
);
dbFacets.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const archFacets = [...tally(products.flatMap((p) => p.data.arch))].filter(
  ([, n]) => n > 0,
);
archFacets.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const langFacets = [...tally(products.map((p) => p.data.language))];
langFacets.sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

for (const p of products) {
  const c = p.data.category;
  categoryCount.set(c, (categoryCount.get(c) ?? 0) + 1);
}

const categoryFacets = categories
  .filter((c) => (categoryCount.get(c.id) ?? 0) > 0)
  .map((c) => [c.id, categoryCount.get(c.id) ?? 0] as const)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const capabilityFacets: { key: string; label: string }[] = [
  { key: "docker", label: "Docker image available" },
  { key: "kubernetes", label: "Runs on Kubernetes" },
  { key: "sso", label: "SSO (OIDC / SAML / LDAP)" },
];

const cpuOptions = [
  { value: "low", label: "Low" },
  { value: "medium", label: "Medium" },
  { value: "high", label: "High" },
];

const ramOptions = [
  { value: "256", label: "≤ 256 MB" },
  { value: "512", label: "≤ 512 MB" },
  { value: "1g", label: "≤ 1 GB" },
  { value: "2g", label: "≤ 2 GB" },
  { value: "4g", label: "≤ 4 GB" },
  { value: "gt4g", label: "> 4 GB" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Self-hostable software catalog",
  description:
    "Search and filter self-hostable software by category, RAM, CPU, architecture, license, database, SSO, Docker and Kubernetes.",
  url: "https://kokoapi.space/apps/",
};
---

<Base
  title="Self-hostable apps catalog — filter & compare"
  description="Search 30+ self-hostable apps and filter by category, RAM usage, CPU footprint, architecture, license, database, SSO, Docker and Kubernetes support."
  jsonLd={jsonLd}
>
  <div class="container page-head">
    <p class="eyebrow">Full catalog</p>
    <h1>Browse self-hostable apps</h1>
    <p class="lead">
      {products.length} apps, fully static. Use the filters below (or a query like{" "}
      <code>/apps/?q=vault&amp;docker=1</code>) to shortlist what fits your server.
    </p>
  </div>

  <div class="container" id="catalog">
    <div class="filter-toolbar">
      <div class="searchbar flex-1">
        <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <label class="sr-only" for="q">Search apps</label>
        <input class="search-input" id="q" name="q" type="search" placeholder="Search name, tagline, tags… (e.g. vault, rss, photos)" autocomplete="off" />
      </div>
      <span class="result-count" data-count role="status">
        Showing {products.length} of {products.length} apps
      </span>
      <button type="button" id="clear-filters" class="btn btn-secondary btn-sm hidden">Reset filters</button>
    </div>

    <div class="filters-layout mt-2">
      <aside class="filter-panel" aria-label="Filters">
        <div class="filter-actions">
          <button type="button" id="filters-toggle" class="btn btn-secondary btn-sm" aria-expanded="false">
            Show filters
          </button>
        </div>

        <details class="facet-box" open>
          <summary>Category</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {categoryFacets.map(([value, count]) => (
                <li>
                  <input type="checkbox" name="category" id={`f-cat-${value}`} value={value} />
                  <label for={`f-cat-${value}`}>
                    {categoryTitle.get(value)}
                    <span class="count">{count}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <details class="facet-box" open>
          <summary>License</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {licenseFacets.map(([value, count]) => (
                <li>
                  <input type="checkbox" name="license" id={`f-lic-${value}`} value={value} />
                  <label for={`f-lic-${value}`}>
                    {value}
                    <span class="count">{count}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <details class="facet-box" open>
          <summary>Database</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {dbFacets.map(([value, count]) => (
                <li>
                  <input type="checkbox" name="db" id={`f-db-${value}`} value={value} />
                  <label for={`f-db-${value}`}>
                    {value}
                    <span class="count">{count}</span>
                  </label>
                </li>
              ))}
            </ul>
            {dbFacets.length === 0 && <p class="text-muted">All apps are self-contained.</p>}
          </div>
        </details>

        <details class="facet-box">
          <summary>Architecture</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {archFacets.map(([value, count]) => (
                <li>
                  <input type="checkbox" name="arch" id={`f-arch-${value}`} value={value} />
                  <label for={`f-arch-${value}`}>
                    {archLabel(value)}
                    <span class="count">{count}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <details class="facet-box">
          <summary>Language</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {langFacets.map(([value, count]) => (
                <li>
                  <input type="checkbox" name="language" id={`f-lang-${value}`} value={value} />
                  <label for={`f-lang-${value}`}>
                    {value}
                    <span class="count">{count}</span>
                  </label>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <details class="facet-box">
          <summary>Typical CPU usage</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {cpuOptions.map((o) => (
                <li>
                  <input type="radio" name="cpu" id={`f-cpu-${o.value}`} value={o.value} />
                  <label for={`f-cpu-${o.value}`}>{cpuLabel(o.value)}</label>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <details class="facet-box">
          <summary>RAM usage</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {ramOptions.map((o) => (
                <li>
                  <input type="radio" name="ram" id={`f-ram-${o.value}`} value={o.value} />
                  <label for={`f-ram-${o.value}`}>{o.label}</label>
                </li>
              ))}
            </ul>
          </div>
        </details>

        <details class="facet-box">
          <summary>Packaging &amp; auth</summary>
          <div class="facet-body">
            <ul class="facet-list">
              {capabilityFacets.map((c) => (
                <li>
                  <input type="checkbox" name={c.key} id={`f-cap-${c.key}`} value="1" />
                  <label for={`f-cap-${c.key}`}>{c.label}</label>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </aside>

      <section aria-label="Apps list">
        <div class="filter-toolbar mb-1">
          <label class="text-muted" for="sort">Sort:</label>
          <select class="filter-select w-auto" id="sort">
            <option value="featured">Featured first</option>
            <option value="name">Name (A–Z)</option>
            <option value="ram">Lowest RAM first</option>
            <option value="newest">Recently reviewed</option>
          </select>
        </div>
        <noscript>
          <p class="text-muted">JavaScript is disabled — filters won't work, but every app is listed below.</p>
        </noscript>
        <div class="grid cards-grid" id="catalog-grid" data-total={products.length}>
          {products.map((p) => (
            <ProductCard product={p} categoryTitle={categoryTitle.get(p.data.category)} />
          ))}
        </div>
        <div class="no-results" id="no-results">
          <strong>No apps match your filters</strong>
          Try removing a filter or clearing the search.
        </div>
      </section>
    </div>
  </div>
</Base>

<script is:inline src="/catalog.js" defer></script>
