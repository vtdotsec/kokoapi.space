---
import Base from "../layouts/Base.astro";

const tools = [
  {
    title: "Image tools",
    path: "/image/",
    desc: "Convert, compress, resize, crop, filter and strip metadata from images locally. Processing happens in your browser; nothing is uploaded.",
  },
  {
    title: "PDF tools",
    path: "/pdf/",
    desc: "Merge, split, rotate, reorder, watermark, compress and convert PDF files entirely in your browser. Your files never leave your device.",
  },
  {
    title: "File converter",
    path: "/convert/",
    desc: "Markdown/HTML/PDF, images, JSON/CSV/XML/YAML, ZIP and GZIP conversions, all executed locally in your browser.",
  },
  {
    title: "Secret Sender",
    path: "/secret/",
    desc: "Share a note, password or small file with a link that expires or burns after one read. Encrypted in your browser before it reaches the server.",
  },
  {
    title: "QR toolkit",
    path: "/qrcode/",
    desc: "Generate QR codes for links, Wi-Fi, contacts and more, or scan a code with your camera or an image — all on your device.",
  },
];

const principles = [
  {
    term: "Open source",
    desc: "The code for these tools and for this site is public and can be reviewed, audited or self-hosted.",
  },
  {
    term: "No account",
    desc: "No sign-up, no login, no profile. Every tool works immediately.",
  },
  {
    term: "No telemetry",
    desc: "No analytics, no tracking pixels, no data collection of any kind.",
  },
  {
    term: "No ads and no cookies",
    desc: "Nothing is sold or profiled. The pages set no cookies.",
  },
  {
    term: "Free",
    desc: "No payments, no quotas, no paywalls. Hosting is paid for out of pocket.",
  },
];
---

<Base
  title="kokoapi.space — open-source web tools"
  description="kokoapi.space hosts open-source web tools: image editing, a PDF toolkit, a file converter, ephemeral encrypted sharing and a QR toolkit. No accounts, no telemetry, no ads, no cookies. Files are processed locally."
>
  <section class="container home-intro">
    <h1>Web tools, without the usual baggage</h1>
    <p class="lead">
      kokoapi.space is a small set of open-source web tools. Everything runs in your
      browser: documents, images, QR codes and short encrypted notes stay on your device
      unless a tool says otherwise.
    </p>
    <p class="intro-sub">
      Everything is free and works without an account. There is no telemetry, no ads, no
      cookies and nothing to pay.
    </p>
  </section>

  <section class="container home-block" aria-labelledby="tools-heading">
    <div class="section-title">
      <h2 id="tools-heading">Tools</h2>
    </div>
    <div class="app-index">
      {tools.map((tool) => (
        <a class="app-row" href={tool.path}>
          <span class="app-row-top">
            <span class="app-row-name">{tool.title}</span>
            <span class="app-row-path">{tool.path}</span>
          </span>
          <span class="app-row-desc">{tool.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-block" aria-labelledby="principles-heading">
    <div class="section-title">
      <h2 id="principles-heading">What you can expect here</h2>
    </div>
    <ul class="principles">
      {principles.map((p) => (
        <li>
          <strong>{p.term}</strong>
          <span class="principles-desc">{p.desc}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
