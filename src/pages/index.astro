---
import Base from "../layouts/Base.astro";

const tools = [
  {
    number: "01",
    title: "Image tools",
    category: "Image · QR",
    path: "/image/",
    desc: "Convert, resize, crop, compress and remove EXIF or GPS metadata. Includes a QR generator. Your images stay in the browser.",
  },
  {
    number: "02",
    title: "PDF tools",
    category: "Documents",
    path: "/pdf/",
    desc: "Merge, split, reorder, rotate, watermark, compress and extract text from PDFs on your device.",
  },
  {
    number: "03",
    title: "File converter",
    category: "Text · Data · Archives",
    path: "/convert/",
    desc: "Convert Markdown, HTML, PDF, images, JSON, CSV, YAML and XML; create or unpack ZIP, TAR and GZIP archives locally.",
  },
  {
    number: "04",
    title: "Secret Sender",
    category: "Encrypted sharing",
    path: "/secret/",
    desc: "Send a note or small file using a one-read or expiring link. The browser encrypts it; the server temporarily stores ciphertext.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "kokoapi.space",
      "url": "https://tools.kokoapi.space/",
      "description": "Free, open-source image, PDF and file conversion tools that process files in your browser, plus Secret Sender for encrypted, expiring links. No account or analytics.",
    },
    {
      "@type": "ItemList",
      "name": "Free file tools",
      "itemListElement": tools.map((tool, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: tool.title,
        url: `https://tools.kokoapi.space${tool.path}`,
      })),
    },
  ],
};
---

<Base
  title="Free PDF, image and file tools — private by default"
  description="Merge and edit PDFs, convert images, clean EXIF metadata and transform files in your browser. Free, open source and no account required."
  jsonLd={jsonLd}
>
  <section class="container home-intro">
    <div class="home-intro-copy">
      <p class="home-kicker"><span></span> Independent file utilities / Open source</p>
      <h1>Useful tools for files.<br /><em>Room to work.</em></h1>
      <p class="lead">
        A small, carefully maintained set of tools for PDFs, images and everyday file formats.
        Start in one click; your documents stay in your browser for most tasks.
      </p>
      <ul class="home-facts" aria-label="Service details">
        <li>No account</li>
        <li>No analytics</li>
        <li>Free to use</li>
      </ul>
    </div>
    <aside class="home-annotation" aria-label="How file processing works">
      <p class="annotation-label">DATA PATH <span>01 / 02</span></p>
      <h2>Local by default.</h2>
      <p>Images, PDFs and conversions are processed on your device. They are not uploaded.</p>
      <div class="annotation-rule"></div>
      <p><strong>One exception:</strong> Secret Sender keeps encrypted content temporarily so a recipient can retrieve it. Its decryption key stays in the link fragment.</p>
      <a href="/secret/">See how Secret Sender works <span aria-hidden="true">↗</span></a>
    </aside>
  </section>

  <section class="container home-block home-tools" aria-labelledby="tools-heading">
    <div class="section-title">
      <p class="section-index">01 / TOOL INDEX</p>
      <h2 id="tools-heading">Choose a workspace.</h2>
      <p>Choose a workspace to see its available operations.</p>
    </div>
    <ol class="app-index">
      {tools.map((tool) => (
        <li>
          <a class="app-row" href={tool.path}>
            <span class="app-row-no">{tool.number}</span>
            <span class="app-row-main">
              <span class="app-row-top">
                <span class="app-row-name">{tool.title}</span>
                <span class="app-row-path">{tool.path}</span>
              </span>
              <span class="app-row-desc">{tool.desc}</span>
            </span>
            <span class="app-row-meta">{tool.category}</span>
            <span class="app-row-arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="container home-block home-note" aria-labelledby="notes-heading">
    <div class="section-title">
      <p class="section-index">02 / PROJECT NOTES</p>
      <h2 id="notes-heading">Made to be inspected.</h2>
    </div>
    <p class="home-note-copy">The source is public and self-hostable. The tools are free, need no account, and do not use analytics or advertising. Most processing happens entirely on your device.</p>
    <a class="source-link" href="https://github.com/vtdotsec/kokoapi.space" rel="noopener noreferrer">Read the source on GitHub <span aria-hidden="true">↗</span></a>
  </section>
</Base>
