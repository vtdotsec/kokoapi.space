const jsonLd = {"@context":"https://schema.org","@graph":[{"@type":"WebSite",name:"koko tools",alternateName:"kokoapi.space",url:"https://tools.kokoapi.space/",inLanguage:"en"},{"@type":"ItemList",name:"Free file tools",itemListElement:groups.map((g,i)=>({"@type":"ListItem",position:i+1,name:g.title,url:"https://tools.kokoapi.space"+g.path}))}]};
---
<Base title="Free PDF, image and file tools" description="Simple, free tools for PDFs, images and file conversions. Work in your browser, without accounts, ads or in-app tracking." jsonLd={jsonLd} scripts={["/_ui/catalog.js"]}>
  <section class="directory container" aria-labelledby="directory-title">
    <p class="directory-eyebrow">KOKO TOOLS / PRIVATE FILE UTILITIES</p>
    <h1 id="directory-title">Your files.<br />Fewer steps.</h1>
    <p class="directory-intro">Simple tools for PDFs, images and everyday formats.<br class="desktop-break" /> No account, ads or in-app tracking. Just choose a task.</p>
    <p class="workflow-promo"><a href="/workflows/">See common workflows for photos, PDFs, downloads and data <span aria-hidden="true">→</span></a></p>
    <div class="catalog-search">
      <label for="tool-search">Find a tool</label>
      <input id="tool-search" type="search" placeholder="Try “compress”, “PDF” or “JSON”" autocomplete="off" spellcheck="false" aria-describedby="search-help" />
      <p id="search-help">Search happens only on this page.</p>
    </div>
    <p id="catalog-status" class="visually-hidden" role="status" aria-live="polite"></p>
    <div class="catalog-grid">
      {groups.map(group => (
        <section class="catalog-group" data-catalog-group aria-label={group.title}>
          <div class="catalog-heading"><h2><a href={group.path}>{group.title}</a></h2><span aria-hidden="true">↗</span></div>
          <p>{group.description}</p>
          <ul>{group.items.map(([label,path,aliases], index) => <li data-catalog-item data-secondary={index >= 4 ? "true" : undefined} hidden={index >= 4} data-search={group.title+" "+label+" "+aliases}><a href={path}>{label}<span aria-hidden="true">→</span></a></li>)}</ul>
          {!group.exception && <a class="catalog-all" href={group.path}>All {group.items.length} {group.title.toLowerCase()} tools →</a>}
          {group.exception && <p class="catalog-exception">Uploads encrypted content and delivery metadata temporarily. <a href="/privacy/">How sharing works</a></p>}
        </section>
      ))}
    </div>
    <p id="catalog-empty" hidden>No matching tools. Try a format such as PDF, PNG or JSON.</p>
    <div class="directory-note"><p>PDF, image and conversion tools process files on your device. Secret Sender uses temporary server storage for sharing.</p><a href="/privacy/">Privacy details →</a></div>
    <p class="project-line">An independent project, built to stay useful, inspectable and free. <a href="https://github.com/vtdotsec/kokoapi.space">Explore the source</a>.</p>
  </section>
</Base>
