---
import Base from "../layouts/Base.astro";

const apps = [
  {
    title: "Self-hosting catalog",
    path: "/catalog/",
    desc: "A directory of software you can run on your own hardware, with license, resource and packaging data for every entry. Static pages maintained as Markdown.",
  },
  {
    title: "Ephemeral sharing",
    path: "/secret/",
    desc: "Share a note, password or small file with a link that expires or burns after one read. Encrypted in your browser before it reaches the server.",
  },
  {
    title: "PDF toolkit",
    path: "/pdf/",
    desc: "Merge, split, rotate and delete PDF pages entirely in your browser. Your files never leave your device.",
  },
];

const principles = [
  {
    term: "Open source",
    desc: "The code for these apps and for this site is public and can be reviewed, audited or self-hosted.",
  },
  {
    term: "No account",
    desc: "No sign-up, no login, no profile. Every app works immediately.",
  },
  {
    term: "No telemetry",
    desc: "No analytics, no tracking pixels, no data collection of any kind.",
  },
  {
    term: "No ads and no cookies",
    desc: "Nothing is sold or profiled. The pages set no cookies.",
  },
  {
    term: "Free",
    desc: "No payments, no quotas, no paywalls. Hosting is paid for out of pocket.",
  },
];
---

<Base
  title="kokoapi.space — open-source web apps"
  description="kokoapi.space hosts small open-source web apps: a self-hosting catalog, ephemeral encrypted sharing and a browser-based PDF toolkit. No accounts, no telemetry, no ads, no cookies."
>
  <section class="container home-intro">
    <h1>Open-source web apps</h1>
    <p class="lead">
      kokoapi.space hosts a small set of open-source applications on its own hardware.
      Everything here is free to use and works without an account. There is no telemetry,
      no ads, no cookies and nothing to pay.
    </p>
    <p class="intro-sub">
      Some apps run as plain static pages in your browser; the rest are small services
      with no database and no user accounts. Source code ships with each app.
    </p>
  </section>

  <section class="container home-block" aria-labelledby="apps-heading">
    <div class="section-title">
      <h2 id="apps-heading">Hosted apps</h2>
    </div>
    <div class="app-index">
      {apps.map((app) => (
        <a class="app-row" href={app.path}>
          <span class="app-row-top">
            <span class="app-row-name">{app.title}</span>
            <span class="app-row-path">{app.path}</span>
          </span>
          <span class="app-row-desc">{app.desc}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container home-block" aria-labelledby="principles-heading">
    <div class="section-title">
      <h2 id="principles-heading">What you can expect here</h2>
    </div>
    <ul class="principles">
      {principles.map((p) => (
        <li>
          <strong>{p.term}</strong>
          <span class="principles-desc">{p.desc}</span>
        </li>
      ))}
    </ul>
  </section>
</Base>
