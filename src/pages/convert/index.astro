---
import Base from "../../layouts/Base.astro";
import { TOOL_LANDINGS } from "../../data/toolLandings";

const tools = TOOL_LANDINGS.filter((e) => e.parentPath === "/convert/");
---

<Base
  title="File converter — convert documents, images, data and archives free"
  description="Every conversion on its own page: Markdown to HTML or PDF, PDF to text, batch images, JSON/CSV/YAML/XML and ZIP/TAR/GZIP — all running locally in your browser."
>
  <section class="container home-intro">
    <h1>File converter</h1>
    <p class="lead">
      A dedicated page for every conversion: documents, images, data formats and
      archives. Each tool runs locally in your browser — no server, no upload, no
      sign-up.
    </p>
  </section>

  <section class="container home-block" aria-labelledby="convert-tools-heading">
    <div class="section-title">
      <h2 id="convert-tools-heading">Converters</h2>
    </div>
    <div class="app-index">
      {tools.map((t) => (
        <a class="app-row" href={`${t.parentPath}${t.slug}/`}>
          <span class="app-row-top">
            <span class="app-row-name">{t.crumb}</span>
            <span class="app-row-path">{`${t.parentPath}${t.slug}/`}</span>
          </span>
          <span class="app-row-desc">{t.description}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
