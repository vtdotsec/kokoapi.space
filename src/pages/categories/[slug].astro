---
import { render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { getProducts, getCategories } from "../../lib/catalog";

export const getStaticPaths = (async () => {
  const categories = await getCategories();
  return categories.map((c) => ({
    params: { slug: c.id },
    props: { category: c },
  }));
}) satisfies GetStaticPaths;

const { category } = Astro.props;
const all = await getProducts();
const { Content } = await render(category);

const products = all.filter((p) => p.data.category === category.id);
const featuredCount = products.filter((p) => p.data.featured).length;
const licenseSummary = [...new Set(products.map((p) => p.data.license))].sort().join(", ");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: `${category.data.title} self-hosted software`,
  description: `A curated list of self-hostable ${category.data.title.toLowerCase()} software with specs and comparisons.`,
  url: `https://kokoapi.space/categories/${category.id}/`,
  isPartOf: { "@type": "WebSite", url: "https://kokoapi.space/" },
};
---

<Base
  title={`Best self-hosted ${category.data.title.toLowerCase()} software`}
  description={`${category.data.tagline} Compare ${products.length} self-hostable ${category.data.title.toLowerCase()} apps by license, RAM, architecture, database and more.`}
  jsonLd={jsonLd}
>
  <div class="container page-head">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="/categories/">Categories</a>
      <span class="sep" aria-hidden="true">/</span>
      <span aria-current="page">{category.data.title}</span>
    </nav>
    <h1>
      {category.data.emoji} {category.data.title} software for self-hosting
    </h1>
    <p class="lead">{category.data.tagline}</p>
  </div>

  <div class="container">
    <div class="prose mb-0">
      <Content />
      {featuredCount > 0 && (
        <p>
          <strong>{featuredCount} featured pick{featuredCount === 1 ? "" : "s"}</strong> are
          marked on this page.
        </p>
      )}
    </div>
  </div>

  <div class="container section">
    <div class="section-title">
      <h2>{products.length} apps in this category</h2>
      <span class="text-muted">Licenses: {licenseSummary}</span>
    </div>
    <div class="grid cards-grid">
      {products.map((p) => (
        <ProductCard product={p} categoryTitle={category.data.title} />
      ))}
    </div>
    <p class="mt-2">
      <a href="/apps/">← Back to the full catalog</a> ·{" "}
      <a href={products[0] ? `/apps/?category=${category.id}` : "/apps/"}>
        Filter the full catalog by this category
      </a>
    </p>
  </div>
</Base>
