---
import Base from "../../layouts/Base.astro";
import { TOOL_LANDINGS } from "../../data/toolLandings";

const tools = TOOL_LANDINGS.filter((e) => e.parentPath === "/image/");
---

<Base
  title="Image tools — edit images online free, no upload"
  description="Convert, compress, crop, watermark, filter, strip metadata, batch-convert and generate QR codes — each tool on its own page, running locally in your browser."
>
  <section class="container home-intro">
    <h1>Image tools</h1>
    <p class="lead">
      A dedicated page for every image task: convert, compress, crop, watermark,
      filters, metadata removal, batch conversion and QR code generation. Each tool runs
      locally in your browser — nothing is ever uploaded.
    </p>
  </section>

  <section class="container home-block" aria-labelledby="image-tools-heading">
    <div class="section-title">
      <h2 id="image-tools-heading">Tools</h2>
    </div>
    <div class="app-index">
      {tools.map((t) => (
        <a class="app-row" href={`${t.parentPath}${t.slug}/`}>
          <span class="app-row-top">
            <span class="app-row-name">{t.crumb}</span>
            <span class="app-row-path">{`${t.parentPath}${t.slug}/`}</span>
          </span>
          <span class="app-row-desc">{t.description}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
