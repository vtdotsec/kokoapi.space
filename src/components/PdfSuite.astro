---
import mergeHtml from "../raw/pdf/merge.html?raw";
import compressHtml from "../raw/pdf/compress.html?raw";
import splitHtml from "../raw/pdf/split.html?raw";
import reorderHtml from "../raw/pdf/reorder.html?raw";
import organizeHtml from "../raw/pdf/organize.html?raw";
import pagenumHtml from "../raw/pdf/pagenum.html?raw";
import watermarkHtml from "../raw/pdf/watermark.html?raw";
import unlockHtml from "../raw/pdf/unlock.html?raw";
import extractHtml from "../raw/pdf/extract.html?raw";
import imgs2pdfHtml from "../raw/pdf/imgs2pdf.html?raw";
import pdf2imgHtml from "../raw/pdf/pdf2img.html?raw";

interface Props {
  slug: string;
}

const NAV = [
  { slug: "merge", label: "Merge", href: "/pdf/merge/", id: "merge" },
  { slug: "compress", label: "Compress", href: "/pdf/compress/", id: "compress" },
  { slug: "split", label: "Split", href: "/pdf/split/", id: "split" },
  { slug: "reorder", label: "Reorder", href: "/pdf/reorder/", id: "reorder" },
  { slug: "rotate", label: "Rotate / Delete", href: "/pdf/rotate/", id: "organize" },
  { slug: "page-numbers", label: "Page numbers", href: "/pdf/page-numbers/", id: "pagenum" },
  { slug: "watermark", label: "Watermark", href: "/pdf/watermark/", id: "watermark" },
  { slug: "unlock", label: "Unlock", href: "/pdf/unlock/", id: "unlock" },
  { slug: "extract-text", label: "Extract text", href: "/pdf/extract-text/", id: "extract" },
  { slug: "images-to-pdf", label: "Images to PDF", href: "/pdf/images-to-pdf/", id: "imgs2pdf" },
  { slug: "pdf-to-images", label: "PDF to images", href: "/pdf/pdf-to-images/", id: "pdf2img" },
];

const { slug } = Astro.props;
const active = NAV.find((n) => n.slug === slug) ?? NAV[0];
const bodyHtml = [mergeHtml, compressHtml, splitHtml, reorderHtml, organizeHtml, pagenumHtml, watermarkHtml, unlockHtml, extractHtml, imgs2pdfHtml, pdf2imgHtml].join("\n");
---

<div class="suite-wrap" data-koko-tool={active.id}>
  <aside class="suite-side" aria-label="Tools">
    <h2 class="suite-title">Tools</h2>
    <nav aria-label="Tools">
      {NAV.map((n) => (
        <a href={n.href} aria-current={n.slug === active.slug ? "page" : undefined}>
          {n.label}
        </a>
      ))}
    </nav>
  </aside>
  <div class="suite-main" set:html={bodyHtml}></div>
</div>
