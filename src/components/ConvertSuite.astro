---
import md2htmlHtml from "../raw/convert/md2html.html?raw";
import m2pHtml from "../raw/convert/m2p.html?raw";
import pdf2txtHtml from "../raw/convert/pdf2txt.html?raw";
import img2Html from "../raw/convert/img2.html?raw";
import jsoncsvHtml from "../raw/convert/jsoncsv.html?raw";
import yamljsonHtml from "../raw/convert/yamljson.html?raw";
import xml2jsonHtml from "../raw/convert/xml2json.html?raw";
import mkzipHtml from "../raw/convert/mkzip.html?raw";
import unpackHtml from "../raw/convert/unpack.html?raw";

interface Props {
  slug: string;
}

const NAV = [
  { slug: "markdown-to-html", label: "Markdown to HTML", href: "/convert/markdown-to-html/", id: "md2html" },
  { slug: "markdown-to-pdf", label: "Markdown / HTML to PDF", href: "/convert/markdown-to-pdf/", id: "m2p" },
  { slug: "pdf-to-text", label: "PDF to text", href: "/convert/pdf-to-text/", id: "pdf2txt" },
  { slug: "convert-images", label: "Convert images", href: "/convert/convert-images/", id: "img2" },
  { slug: "json-to-csv", label: "JSON ↔ CSV", href: "/convert/json-to-csv/", id: "jsoncsv" },
  { slug: "json-to-yaml", label: "JSON ↔ YAML", href: "/convert/json-to-yaml/", id: "yamljson" },
  { slug: "xml-to-json", label: "XML to JSON", href: "/convert/xml-to-json/", id: "xml2json" },
  { slug: "create-archive", label: "Create archive", href: "/convert/create-archive/", id: "mkzip" },
  { slug: "extract-archive", label: "Extract archive", href: "/convert/extract-archive/", id: "unpack" },
];

const { slug } = Astro.props;
const active = NAV.find((n) => n.slug === slug) ?? NAV[0];
const bodyHtml = [md2htmlHtml, m2pHtml, pdf2txtHtml, img2Html, jsoncsvHtml, yamljsonHtml, xml2jsonHtml, mkzipHtml, unpackHtml].join("\n");
---

<div class="suite-wrap" data-koko-tool={active.id}>
  <aside class="suite-side" aria-label="Tools">
    <h2 class="suite-title">Tools</h2>
    <nav aria-label="Tools">
      {NAV.map((n) => (
        <a href={n.href} aria-current={n.slug === active.slug ? "page" : undefined}>
          {n.label}
        </a>
      ))}
    </nav>
  </aside>
  <div class="suite-main" set:html={bodyHtml}></div>
</div>
