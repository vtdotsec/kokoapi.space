---
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  return pathname === href || pathname.startsWith(href);
}

const links = [
  { href: "/image/", label: "Image tools" },
  { href: "/pdf/", label: "PDF tools" },
  { href: "/convert/", label: "File converter" },
  { href: "/secret/", label: "Secret Sender" },
];
---

<header class="topbar">
  <div class="wrap">
    <a class="brand" href="/" aria-label="kokoapi.space — home">
      <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
        <rect class="lg-plate" width="64" height="64" rx="13" />
        <rect class="lg-screen" x="12" y="14" width="40" height="36" rx="5" />
        <rect class="lg-ink" x="18" y="24" width="19" height="4.5" rx="2" />
        <rect class="lg-cursor" x="40.5" y="22.5" width="5" height="7.5" rx="1.5" />
        <rect class="lg-ink" x="18" y="33" width="12" height="4.5" rx="2" />
      </svg>
      <span>kokoapi<span class="space">.space</span></span>
    </a>

    <nav class="main-nav" aria-label="Tools">
      {links.map((link) => (
        <a class:list={["main-nav-link", { current: isActive(link.href) }]} href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>

    <span class="top-actions">
      <button type="button" class="nav-btn" id="theme-toggle" aria-label="Switch to light theme" title="Light">
        <span class="theme-ico-light" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="8" cy="8" r="3.2" />
            <path d="M8 1.2v2M8 12.8v2M1.2 8h2M12.8 8h2M3 3l1.4 1.4M11.6 11.6 13 13M13 3l-1.4 1.4M4.4 11.6 3 13" />
          </svg>
        </span>
        <span class="theme-ico-dark" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M13.4 9.6A5.6 5.6 0 0 1 6.4 2.6a5.6 5.6 0 1 0 7 7Z" />
          </svg>
        </span>
      </button>
    </span>
  </div>
</header>
