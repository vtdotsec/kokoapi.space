---
const pathname = Astro.url.pathname;

function isActive(prefix: string): boolean | undefined {
  return pathname === prefix || pathname.startsWith(prefix) ? true : undefined;
}
---

<header class="site-header">
  <div class="container">
    <a class="brand" href="/" aria-label="kokoapi.space — home">
      <svg class="logo" viewBox="0 0 64 64" aria-hidden="true">
        <rect class="lg-plate" width="64" height="64" rx="13" />
        <rect class="lg-screen" x="12" y="14" width="40" height="36" rx="5" />
        <rect class="lg-ink" x="18" y="24" width="19" height="4.5" rx="2" />
        <rect class="lg-cursor" x="40.5" y="22.5" width="5" height="7.5" rx="1.5" />
        <rect class="lg-ink" x="18" y="33" width="12" height="4.5" rx="2" />
      </svg>
      <span>kokoapi<span class="space">.space</span></span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <a href="/catalog/" aria-current={isActive("/catalog/")}>Catalog</a>
      <a href="/secret/">Secret</a>
      <a href="/pdf/">PDF tools</a>
    </nav>
  </div>
</header>
