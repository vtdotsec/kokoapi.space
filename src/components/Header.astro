---
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/utilities/" && (pathname.startsWith("/files/") || pathname.startsWith("/text/"))) return true;
  return pathname === href || pathname.startsWith(href);
}

const links = [
  { href: "/image/", label: "Images" },
  { href: "/pdf/", label: "PDF" },
  { href: "/convert/", label: "Convert" },
  { href: "/utilities/", label: "Utilities" },
  { href: "/secret/", label: "Share" },
];
---

<header class="topbar">
  <div class="wrap">
    <a class="brand" href="/" aria-label="koko tools — home">
      <svg class="logo brand-mark" viewBox="0 0 40 40" aria-hidden="true"><rect x="5" y="5" width="7" height="30" rx="3.5" fill="currentColor"/><path d="M20 5h14L18 21l-5-5zm-2 17 16 13H20l-7-8z" fill="currentColor"/></svg>
      <span class="brand-name">koko<span class="brand-descriptor">tools</span></span>
    </a>

    <nav class="main-nav" aria-label="Tools">
      {links.map((link) => (
        <a class:list={["main-nav-link", { current: isActive(link.href) }]} href={link.href} aria-current={isActive(link.href) ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <span class="top-actions">
      <button type="button" class="nav-btn" id="theme-toggle" aria-label="Switch to dark theme" title="Dark">
        <span class="theme-ico-light" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <circle cx="8" cy="8" r="3.2" />
            <path d="M8 1.2v2M8 12.8v2M1.2 8h2M12.8 8h2M3 3l1.4 1.4M11.6 11.6 13 13M13 3l-1.4 1.4M4.4 11.6 3 13" />
          </svg>
        </span>
        <span class="theme-ico-dark" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M13.4 9.6A5.6 5.6 0 0 1 6.4 2.6a5.6 5.6 0 1 0 7 7Z" />
          </svg>
        </span>
      </button>
    </span>
  </div>
</header>
