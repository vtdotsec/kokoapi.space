---
import type { Product } from "../lib/catalog";
import { appPath, cpuLabel, formatRam, ramTier } from "../lib/catalog";

interface Props {
  product: Product;
  categoryTitle?: string;
}

const { product, categoryTitle } = Astro.props;
const { data } = product;
const href = appPath(product.id);
const tier = ramTier(data.ramMb);

const searchText = [
  data.title,
  data.tagline,
  data.category,
  categoryTitle,
  data.license,
  data.language,
  ...data.tags,
  ...data.databases,
].join(" ");
---

<article
  class="card product-card"
  data-product
  data-slug={product.id}
  data-name={data.title.toLowerCase()}
  data-search={searchText.toLowerCase()}
  data-category={data.category}
  data-license={data.license}
  data-language={data.language}
  data-arch={data.arch.join(" ")}
  data-databases={data.databases.join(" ")}
  data-tags={data.tags.join(" ")}
  data-cpu={data.cpu}
  data-ram={data.ramMb}
  data-ramtier={tier}
  data-docker={data.docker ? "1" : "0"}
  data-kubernetes={data.kubernetes ? "1" : "0"}
  data-sso={data.sso ? "1" : "0"}
  data-featured={data.featured ? "1" : "0"}
  data-updated={data.updated}
>
  <div class="card-topline">
    <span class="chip chip-accent">{categoryTitle ?? data.category}</span>
    {data.featured && (
      <span class="featured-dot" title="Featured pick" aria-label="Featured pick"></span>
    )}
    {data.kubernetes && <span class="chip">Kubernetes</span>}
  </div>

  <h3 class="card-title">
    <a href={href}>{data.title}</a>
  </h3>

  <p class="card-desc">{data.tagline}</p>

  <div class="card-meta" aria-label={`${data.title} specs`}>
    <span class="kv"><strong>RAM</strong>~{formatRam(data.ramMb)}</span>
    <span class="kv"><strong>CPU</strong>{cpuLabel(data.cpu)}</span>
    <span class="kv"><strong>License</strong>{data.license}</span>
    {data.sso && <span class="kv"><strong>SSO</strong>Yes</span>}
    {!data.sso && <span class="kv"><strong>Docker</strong>{data.docker ? "Yes" : "No"}</span>}
  </div>
</article>
