---
import type { Product } from "../lib/catalog";
import { appPath, cpuLabel, formatRam, ramTier } from "../lib/catalog";

interface Props {
  product: Product;
  categoryTitle?: string;
}

const { product, categoryTitle } = Astro.props;
const { data } = product;
const href = appPath(product.id);
const tier = ramTier(data.ramMb);

const searchText = [
  data.title,
  data.tagline,
  data.category,
  categoryTitle,
  data.license,
  data.language,
  ...data.tags,
  ...data.databases,
].join(" ");
---

<article
  class="card product-card"
  data-product
  data-slug={product.id}
  data-name={data.title.toLowerCase()}
  data-search={searchText.toLowerCase()}
  data-category={data.category}
  data-license={data.license}
  data-language={data.language}
  data-arch={data.arch.join(" ")}
  data-databases={data.databases.join(" ")}
  data-tags={data.tags.join(" ")}
  data-cpu={data.cpu}
  data-ram={data.ramMb}
  data-ramtier={tier}
  data-docker={data.docker ? "1" : "0"}
  data-kubernetes={data.kubernetes ? "1" : "0"}
  data-sso={data.sso ? "1" : "0"}
  data-featured={data.featured ? "1" : "0"}
  data-updated={data.updated}
>
  <div class="card-topline">
    <span class="card-cat">{categoryTitle ?? data.category}</span>
    {data.featured && <span class="pick">Featured</span>}
  </div>

  <h3 class="card-title">
    <a href={href}>{data.title}</a>
  </h3>

  <p class="card-desc">{data.tagline}</p>

  <div class="card-meta" aria-label={`${data.title} specs`}>
    <span class="kv"><span class="k">RAM</span><b>~{formatRam(data.ramMb)}</b></span>
    <span class="kv"><span class="k">CPU</span><b>{cpuLabel(data.cpu)}</b></span>
    <span class="kv"><span class="k">License</span><b>{data.license}</b></span>
    {data.kubernetes && <span class="kv"><span class="k">Kubernetes</span><b>Yes</b></span>}
    {data.sso && <span class="kv"><span class="k">SSO</span><b>Yes</b></span>}
    {!data.sso && <span class="kv"><span class="k">Docker</span><b>{data.docker ? "Yes" : "No"}</b></span>}
  </div>
</article>
