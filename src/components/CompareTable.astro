---
import type { Product } from "../lib/catalog";
import { appPath, archLabel, cpuLabel, formatRam } from "../lib/catalog";

interface Props {
  current: Product;
  peers: Product[];
}

const { current, peers } = Astro.props;

const cols = [current, ...peers];
const yesNo = (v: boolean) => (v ? "Yes" : "No");

const rows: { label: string; value: (p: Product) => string }[] = [
  { label: "License", value: (p) => p.data.license },
  { label: "Language", value: (p) => p.data.language },
  { label: "Min. RAM", value: (p) => formatRam(p.data.ramMb) },
  { label: "CPU footprint", value: (p) => cpuLabel(p.data.cpu) },
  {
    label: "Database",
    value: (p) =>
      p.data.databases.length > 0 ? p.data.databases.join(" / ") : "Self-contained",
  },
  { label: "Architectures", value: (p) => p.data.arch.map(archLabel).join(" / ") },
  { label: "SSO / OIDC", value: (p) => yesNo(p.data.sso) },
  { label: "Docker image", value: (p) => yesNo(p.data.docker) },
  { label: "Kubernetes", value: (p) => yesNo(p.data.kubernetes) },
];
---

<div class="compare-wrap">
  <table class="compare-table">
    <caption class="sr-only">
      Comparison between {cols.map((c) => c.data.title).join(", ")}
    </caption>
    <thead>
      <tr>
        <th scope="col">Spec</th>
        {cols.map((c, i) => (
          <th scope="col" class:list={{ "is-current": i === 0 }}>
            {c.data.title}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          {cols.map((c, i) => (
            <td>
              {i === 0 ? (
                row.value(c)
              ) : (
                <a href={appPath(c.id)} class="muted">
                  {row.value(c)}
                </a>
              )}
            </td>
          ))}
        </tr>
      ))}
      <tr>
        <th scope="row">Details</th>
        {cols.map((c, i) => (
          <td>
            <a href={appPath(c.id)}>{i === 0 ? "Current page" : "Open page"}</a>
          </td>
        ))}
      </tr>
    </tbody>
  </table>
</div>
