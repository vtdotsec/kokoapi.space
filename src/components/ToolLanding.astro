---
import type { ToolLandingEntry } from "../data/toolLandings";

interface Props {
  entry: ToolLandingEntry;
}

// Landing body for one focused tool page: breadcrumb, intro, the real tool
// widget (the existing app embedded pre-selected) and unique SEO copy.
// Head/metadata and Schema.org live in the page that uses this component.
const { entry } = Astro.props;
const howtoId = `howto-${entry.slug}`;
const faqId = `faq-${entry.slug}`;
---

<div class="container tool-landing">
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href={entry.parentPath}>{entry.parentLabel}</a></li>
      <li aria-current="page">{entry.crumb}</li>
    </ol>
  </nav>

  <h1>{entry.h1}</h1>
  <p class="lead">{entry.lead}</p>
  <p class="intro-sub">{entry.note}</p>

  <div class="tool-widget">
    <iframe
      data-koko-widget
      src={entry.iframeSrc}
      title={entry.widgetTitle}
      loading="eager"
    ></iframe>
    <noscript>
      <p class="note">This tool needs JavaScript — your file is processed locally in your browser.</p>
    </noscript>
  </div>

  <section class="tool-section" aria-labelledby={howtoId}>
    <div class="section-title">
      <h2 id={howtoId}>{entry.howtoHeading}</h2>
    </div>
    <ol class="howto">
      {entry.steps.map((step, i) => (
        <li>
          <strong>Step {i + 1}: {step.title}.</strong> {step.text}
        </li>
      ))}
    </ol>
  </section>

  <section class="tool-section faq" aria-labelledby={faqId}>
    <div class="section-title">
      <h2 id={faqId}>Frequently asked questions</h2>
    </div>
    {entry.faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <p class="related">
    <span>Related:</span>
    {entry.related.map((r) => (
      <a href={r.href}>{r.label}</a>
    ))}
  </p>
</div>

<script is:inline src="/_ui/landing.js" defer></script>
