---
import ToolCopy from "./ToolCopy.astro";
import type { ToolLandingEntry } from "../data/toolLandings";

interface Props {
  entry: ToolLandingEntry;
}

const { entry } = Astro.props;
---

<ToolCopy entry={entry}>
  <div class="tool-widget">
    <iframe
      data-koko-widget
      src={entry.iframeSrc}
      title={entry.widgetTitle}
      loading="eager"
    ></iframe>
    <noscript>
      <p class="note">This tool needs JavaScript — your file is processed locally in your browser.</p>
    </noscript>
  </div>
</ToolCopy>

<script is:inline src="/_ui/landing.js" defer></script>
